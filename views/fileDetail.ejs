<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title><%= file.name %> | File Uploader</title>
	</head>
	<body>
		<h1><%= file.name %></h1>
		<p>Size: <%= file.size / 1000000 %> MB</p>
		<small>Uploaded at: <%= file.uploadedAt %></small>
	</body>
</html>
