<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title><%= folder.name %> | File Uploader</title>
	</head>
	<body>
        <%- include("partials/header") %>
        
		<h1><%= folder.name %></h1>
		<ul>
			<% for (const file of folder.files) { %>
				<li>
					<%- include("partials/file", { file }) %>
				</li>
			<% } %>
		</ul>
	</body>
</html>
